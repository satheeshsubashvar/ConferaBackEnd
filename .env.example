PGHOST=localhost
PGPORT=5432
PGDATABASE=Confera
PGUSER=postgres
PGPASSWORD=change_me
JWT_SECRET=change-this-to-a-long-random-string-in-production
PORT=4000
# Base URL used to build uploaded file URLs. Leave this UNSET — the
# backend derives the correct URL from whatever host actually served
# the request, so this works on localhost and in production with no
# per-environment editing. Only set it if files are served from a
# different host than the API itself (e.g. a CDN).
#UPLOADS_BASE_URL=https://your-cdn-domain.example.com/uploads

# Fallback used to build the "verify your email" link sent on signup,
# for requests where the Origin header isn't present. Normally not
# needed — the Admin app's own URL is read from the signup request
# automatically. Set this only if resending verification emails from
# a server-side/cron context with no request Origin.
#ADMIN_APP_URL=https://your-admin-app.example.com

# Fallback used to build Portal password-reset/invite links (Forgot
# your password?, and the email sent automatically when someone is
# added as an Attendee/Speaker/Sponsor/Exhibitor) for requests with no
# Origin header, and always for invite emails sent from Admin (Admin's
# own origin isn't the Portal's). Defaults to http://localhost:5174.
#PORTAL_APP_URL=https://your-portal-app.example.com

# ── Outgoing email (verification links) ─────────────────────────────
# Leave all of these UNSET to keep the current dev behavior: the
# verification link is logged to the server console and returned in
# the signup API response so the Admin frontend can show it directly.
# Set SMTP_HOST + SMTP_USER + SMTP_PASS to send real emails instead —
# works with any SMTP provider.
#
# Gmail:
#   1. Turn on 2-Step Verification on the Google account that will send
#      the mail: https://myaccount.google.com/security
#   2. Create an "App password" at https://myaccount.google.com/apppasswords
#      (choose app "Mail", any device name) — Google gives you a
#      16-character password. Your normal Gmail password will NOT work here.
#   3. SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your Gmail
#      address, SMTP_PASS=that 16-character app password.
#
# Other providers (Outlook/Microsoft 365, SendGrid, Mailgun, Amazon SES,
# etc.) all work the same way — use the SMTP host/port/credentials they
# give you.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=your-address@gmail.com
#SMTP_PASS=your-16-character-app-password
# Optional: sender name/address shown to recipients. Defaults to
# "Confera <SMTP_USER>" if unset.
#MAIL_FROM="Confera <your-address@gmail.com>"
